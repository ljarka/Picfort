# Copy to .env and load with: set -a; . ./.env; set +a
IMMICH_URL=https://photos.example.com
IMMICH_API_KEY=
# Panel resolution as the driver expects its buffer
FRAME_WIDTH=1200
FRAME_HEIGHT=1600
# auto | portrait | landscape
FRAME_ORIENTATION=auto
# cover (fill, crop edges) | contain (whole photo, padded)
FRAME_FIT=cover
FRAME_BACKGROUND=white
# Display driver. For the Waveshare 13.3" e-Paper HAT+ (E):
#   FRAME_DRIVER=epd13in3E
#   FRAME_DRIVER_PATH=/home/pi/13.3inch_e-Paper_E/RaspberryPi/python/lib
# Leave FRAME_DRIVER empty for preview-only mode (no hardware).
FRAME_DRIVER=
FRAME_DRIVER_PATH=
# spectra6 = dither to the panel's 6 inks (recommended) | none
FRAME_DITHER=spectra6
# Optional: 6 hex colours black,white,yellow,red,blue,green as they look on your panel
# FRAME_PALETTE=#191e21,#e8e8e0,#e2ce24,#a02020,#22489c,#326a3c
FRAME_SATURATION=1.3
FRAME_CONTRAST=1.1
FRAME_MIN_INTERVAL=30
# Where slideshow settings are saved
FRAME_STATE_PATH=slideshow.json
PORT=5000
# Family Wall storage
WALL_DB_PATH=wall.db
WALL_PHOTOS_PATH=wall_photos
