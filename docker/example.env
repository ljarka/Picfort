# Picfort server settings. See README (Picfort server) for all options.

# Your Immich server: the same address the Picfort app logs in to.
IMMICH_URL=https://photos.example.com
# Immich → Account settings → API keys. Permissions: asset.read, asset.view,
# asset.download, album.read (README: Immich API key).
IMMICH_API_KEY=

# Optional. Set it (e.g. `openssl rand -hex 32`) before making the server reachable from outside,
# for example through Cloudflare Tunnel; then enter the same key in the app next to the address.
PICFORT_API_KEY=

# Port on this machine. In the app: Settings → Picfort server → <this machine's IP>:5000
PICFORT_PORT=5000

# Where the Family Wall and its photos, the shopping lists, the family profiles and the slideshow settings are kept. Back it up.
DATA_LOCATION=./data

# Image version: latest, or a release such as v0.3.0
PICFORT_VERSION=latest
